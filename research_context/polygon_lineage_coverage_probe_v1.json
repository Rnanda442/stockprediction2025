  "probe": {
    "dates": 3,
    "date_selection": "deterministic first-middle-last across the pre-holdout source calendar",
    "grouped_daily_adjusted": false,
    "include_otc": false,
    "historical_ticker_snapshot": true
  },
  "cutoff_policy": {
