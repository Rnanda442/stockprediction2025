    "sealed_holdout_read": false
  },
  "guardrails": {
    "api_key_must_not_be_logged_or_committed": true,
    "source_database_read_only": true,
    "model_training_or_scoring_allowed": false,
    "promotion_allowed": false,
    "full_backfill_requires_probe_review": true
  },
  "success_criteria": {
    "all_probe_dates_completed": true,
    "daily_bars_returned": true,
    "dated_ticker_snapshots_returned": true,
    "source_coverage_deltas_quantified": true,
    "sealed_holdout_opened": false
  },
  "compute_location": "OpenScienceLab",
  "bulk_artifact_policy": "Keep provider responses and SQLite artifacts on OpenScienceLab; commit only compact specifications and reviewed summaries.",
  "status": "approved_next"
}
