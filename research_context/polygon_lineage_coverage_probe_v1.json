{
  "experiment_id": "polygon_lineage_coverage_probe_v1",
  "design_signature": "polygon-lineage-coverage-probe-v1:3dates:grouped-daily+dated-tickers:source-comparison:preholdout-only:no-model",
  "stage": "external_lineage_coverage_validation",
  "objective": "Measure how much full-market point-in-time Polygon coverage is absent from the current survivor-selected source before approving a five-year backfill.",
  "provider": "Polygon/Massive",
  "inputs": {
